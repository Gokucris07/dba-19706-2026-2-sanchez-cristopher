# ---------------------------------------------------------------------------
# Plantilla de variables de entorno. NO contiene secretos reales.
# Copia este archivo como .env y cambia los valores:
#     cp .env.example .env          (Linux / Git Bash)
#     Copy-Item .env.example .env   (PowerShell)
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=lab01

# Contraseña del rol de aplicación app_lab02 (LAB-02, conexiones TLS)
LAB02_APP_PASSWORD=CAMBIAR

# Clave simétrica de laboratorio para cifrar el RFC (LAB-02, actividad 2).
# Es un valor ficticio, solo para práctica. Nunca uses aquí una clave real.
LAB02_CLAVE_RFC=CAMBIAR

# Clave para cifrar respaldos con openssl (LAB-02, evidencia 07). Distinta a la del RFC.
LAB02_CLAVE_RESPALDO=CAMBIAR
